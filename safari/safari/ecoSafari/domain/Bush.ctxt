comment3.target=java.awt.Color getColor()
comment4.target=void tic()
comment5.target=void tac()
comment6.target=boolean closeElephant()
comment6.text=\r\n Determines whether there is an Elephant in one of the four\r\n cardinal neighboring cells (North, South, East, West).\r\n @return\r\n
